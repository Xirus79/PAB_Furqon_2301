<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PAB_2301">

        <!-- Login (Halaman Pertama / Launcher) -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.PAB_2301.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:label="Masuk">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Registrasi -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.PAB_2301.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:label="Daftar Akun" />

        <!-- Reset Password -->
        <activity
            android:name=".ResetPasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.PAB_2301.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:label="Reset Kata Sandi" />

        <!-- Halaman Utama (Home) -->
        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:theme="@style/Theme.PAB_2301.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:label="Halaman Utama" />

        <!-- Halaman Form Pendaftaran (Modul PAB Sebelumnya) -->
        <activity
            android:name=".activitymain"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="Form Pendaftaran" />

        <!-- Halaman Hasil (Modul PAB Sebelumnya) -->
        <activity
            android:name=".DuaActivity"
            android:exported="false"
            android:label="Hasil Pendaftaran" />
    </application>

</manifest>
